{
  "name": "noti-kg-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "cp ../firestore.rules firestore.rules && cp ../storage.rules storage.rules",
    "test": "firebase emulators:exec --only firestore,storage \"node rules.test.mjs\"",
    "test:debug": "firebase emulators:exec --inspect-functions --only firestore,storage \"node rules.test.mjs\"",
    "provision:admin": "node provision_admin.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase-admin": "^13.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
